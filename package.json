{
  "name": "dbiz-combined-app",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "install:apps": "npm install --prefix backend && npm install --prefix frontend",
    "build": "npm run build --prefix frontend",
    "hostinger:build": "npm run install:apps && npm run build",
    "setup": "npm run install:apps",
    "start": "node backend/server.js",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\""
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}